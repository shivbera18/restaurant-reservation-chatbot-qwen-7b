# GoodFoods AI Concierge - configuration
# Copy this file to `.env` and fill in whichever backend you want to use.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)

# Which backend to use: ollama | gemini | openai
LLM_PROVIDER=ollama


# --- Option 1: Ollama (local, no API key) ----------------------------------
# Start the server with `ollama serve`, then `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# OLLAMA_KEEP_ALIVE=10m


# --- Option 2: Google Gemini ----------------------------------------------
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash


# --- Option 3: Any OpenAI-compatible API ----------------------------------
# Works with OpenAI, Groq, OpenRouter, Together, DeepSeek, LM Studio, vLLM.
# OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
#
# Groq:       OPENAI_API_BASE=https://api.groq.com/openai/v1
#             OPENAI_MODEL=llama-3.3-70b-versatile
# OpenRouter: OPENAI_API_BASE=https://openrouter.ai/api/v1
#             OPENAI_MODEL=google/gemini-2.5-flash
# LM Studio:  OPENAI_API_BASE=http://localhost:1234/v1


# --- Generation parameters (optional) -------------------------------------
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
# Ollama only:
LLM_NUM_CTX=2048
LLM_REPEAT_PENALTY=1.1
# 0 = use the provider's own default
LLM_MAX_OUTPUT_TOKENS=0
LLM_REQUEST_TIMEOUT=120

# Verbose request/response logging in the terminal
DEBUG=true
