# GoodFoods AI Concierge - configuration
# Copy this file to `.env` and fill in whichever backend you want to use.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)

# Which backend to use:
# ollama | gemini | openai | groq | openrouter | together | deepseek |
# fireworks | lmstudio | vllm
LLM_PROVIDER=ollama


# --- Option 1: Ollama (local, no API key) ----------------------------------
# Start the server with `ollama serve`, then `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# OLLAMA_KEEP_ALIVE=10m


# --- Option 2: Google Gemini ----------------------------------------------
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash


# --- Option 3: OpenAI-compatible APIs -------------------------------------
# Named services select their own URL and key variable automatically.
# Groq:       LLM_PROVIDER=groq
#             GROQ_API_KEY=your-key-here
# OpenRouter: LLM_PROVIDER=openrouter
#             OPENROUTER_API_KEY=your-key-here
# Together:   LLM_PROVIDER=together
#             TOGETHER_API_KEY=your-key-here
# DeepSeek:   LLM_PROVIDER=deepseek
#             DEEPSEEK_API_KEY=your-key-here
# Fireworks:  LLM_PROVIDER=fireworks
#             FIREWORKS_API_KEY=your-key-here
# LM Studio:  LLM_PROVIDER=lmstudio  # set LMSTUDIO_MODEL to the loaded model
# vLLM:       LLM_PROVIDER=vllm      # set VLLM_MODEL to the served model
#
# Any other OpenAI-compatible API:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# Per-service overrides are also supported, e.g. GROQ_MODEL / GROQ_API_BASE.


# --- Generation parameters (optional) -------------------------------------
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
# Ollama only:
LLM_NUM_CTX=2048
LLM_REPEAT_PENALTY=1.1
# 0 = use the provider's own default
LLM_MAX_OUTPUT_TOKENS=0
LLM_REQUEST_TIMEOUT=120

# Metadata-only debug logging; never logs prompts, tool arguments, or responses.
DEBUG=false
